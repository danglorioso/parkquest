{
  "expo": {
    "name": "ParkQuest",
    "slug": "parkquest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "parkquest",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F2EBDB"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.danglorioso.parkquest",
      "buildNumber": "1",
      "developmentTeam": "U8AK9PG243",
      "infoPlist": {
        "NSCameraUsageDescription": "ParkQuest uses your camera to capture and share photos from your park visits."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.parkquest.app",
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        { "photosPermission": "ParkQuest needs access to your photos to share your adventures." }
      ],
      [
        "expo-location",
        { "locationWhenInUsePermission": "ParkQuest uses your location to show nearby parks." }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
