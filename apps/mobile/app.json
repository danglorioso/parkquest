{
  "expo": {
    "name": "ParkQuest",
    "slug": "parkquest",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "parkquest",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F2EBDB"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.danglorioso.parkquest",
      "buildNumber": "58",
      "developmentTeam": "U8AK9PG243",
      "associatedDomains": [
        "applinks:parkquest.me"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "ParkQuest uses your camera to capture and share photos from your park visits.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.parkquest.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-secure-store",
      "@sentry/react-native/expo",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1F3D2E",
          "sounds": [],
          "mode": "production"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ParkQuest needs access to your photos to share your adventures."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ParkQuest uses your location to show nearby parks."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2689b440-3af8-4807-9f93-e606c68556bb"
      }
    },
    "owner": "danglorioso"
  }
}
